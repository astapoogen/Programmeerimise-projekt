def load_user_data():
    """Laeb kasutaja salvestatud lemmikbuild'id failist."""
    if not DATA_FILE.exists():
        return []

    try:
        with DATA_FILE.open("r", encoding="utf-8") as file:
            data = json.load(file)
        return data if isinstance(data, list) else []
    except (OSError, json.JSONDecodeError):
        return []


def save_user_data(builds):
    """Salvestab build'id JSON-faili."""
    with DATA_FILE.open("w", encoding="utf-8") as file:
        json.dump(builds, file, ensure_ascii=False, indent=4)


def get_known_synergies(selected_items):
    """Tagastab teadaolevad sünergiad, mille mõlemad esemed on valitud."""
    selected = set(selected_items)
    matches = []

    for synergy in KNOWN_SYNERGIES:
        if set(synergy["items"]).issubset(selected):
            matches.append(synergy)

    return matches


def calculate_advisor_score(candidate, selected_items):
    """
    Arvutab lihtsustatud sobivusskoori.

    Skoor põhineb kandidaat-eseme märksõnadel ja build'is veel
    puudu olevatel omadustel. See ei ennusta mängu tegelikku tulemust.
    """
    candidate_tags = set(ITEMS[candidate]["tags"])
    current_tags = set()

    for item in selected_items:
        current_tags.update(ITEMS[item]["tags"])

    # Uued omadused annavad punkte, korduvad omadused vähem.
    new_tags = candidate_tags - current_tags
    shared_tags = candidate_tags & current_tags

    score = len(new_tags) * 2 + len(shared_tags)
    score += ITEMS[candidate]["quality"]

    # Väike boonus teadaoleva sünergia eest.
    for synergy in KNOWN_SYNERGIES:
        if candidate in synergy["items"]:
            other_item = next(
                (item for item in synergy["items"]
                 if item != candidate and item in selected_items),
                None
            )
            if other_item:
                score += 4

    return score


def get_recommendations(selected_items, limit=8):
    """Koostab valitud build'i põhjal järjestatud esemesoovitused."""
    recommendations = []

    for item in ITEMS:
        if item in selected_items:
            continue

        score = calculate_advisor_score(item, selected_items)
        recommendations.append((item, score))

    recommendations.sort(key=lambda result: result[1], reverse=True)
    return recommendations[:limit]


