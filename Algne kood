    def refresh_item_list(self):
        """Uuendab esemete loendit otsingusõna põhjal."""
        if not hasattr(self, "item_list"):
            return

        search = self.search_var.get().lower()
        self.item_list.delete(0, tk.END)

        for item in sorted(ITEMS):
            if search in item.lower():
                self.item_list.insert(tk.END, item)

    def refresh_build_list(self):
        """Uuendab praeguse build'i esemete loendit."""
        if not hasattr(self, "build_list"):
            return

        self.build_list.delete(0, tk.END)
        for item in sorted(self.selected_items):
            self.build_list.insert(tk.END, item)

    def add_selected_item(self, _event: tk.Event | None = None) -> None:
        """Lisab esemete loendist valitud eseme build'i."""
        selection = self.item_list.curselection()
        if not selection:
            return

        item = self.item_list.get(selection[0])
        self.selected_items.add(item)
        self.refresh_build_list()

    def remove_selected_item(self):
        """Eemaldab build'ist valitud eseme."""
        selection = self.build_list.curselection()
        if not selection:
            return

        item = self.build_list.get(selection[0])
        self.selected_items.discard(item)
        self.refresh_build_list()

    def clear_build(self):
        """Tühjendab praeguse build'i."""
        self.selected_items.clear()
        self.refresh_build_list()

    @staticmethod
    def update_text(widget, content):
        """Asendab tekstivälja sisu uue tekstiga."""
        widget.config(state="normal")
        widget.delete("1.0", tk.END)
        widget.insert(tk.END, content)
        widget.config(state="disabled")

    def show_synergies(self):
        """Kuvab praeguse build'i teadaolevad sünergiad."""
        if len(self.selected_items) < 2:
            result = "Vali kõigepealt vähemalt kaks eset vahelehel „Minu build”."
        else:
            matches = get_known_synergies(self.selected_items)
            if not matches:
                result = (
                    "Andmebaasis ei leitud nende esemete vahel teadaolevat "
                    "sünergiat.\nSee ei tähenda, et mängus sünergia puudub – "
                    "programmi sünergiaandmestik on praegu piiratud."
                )
            else:
                lines = []
                for synergy in matches:
                    lines.append("• " + synergy["name"])
                    lines.append("  " + synergy["details"])
                    lines.append("")
                result = "\n".join(lines)

        self.update_text(self.synergy_output, result)

    def show_recommendations(self):
        """Kuvab praeguse build'i põhjal soovitatud esemed."""
        recommendations = get_recommendations(self.selected_items)

        if not recommendations:
            result = "Soovituste koostamiseks pole piisavalt andmeid."
        else:
            lines = [
                "Soovitused (suurem skoor tähendab paremat sobivust programmi reeglite järgi):",
                ""
            ]
            for number, (item, score) in enumerate(recommendations, start=1):
                data = ITEMS[item]
                lines.append(f"{number}. {item}  – skoor: {score}")
                lines.append(f"   Tüüp: {data['type']} | Kvaliteet: {data['quality']}/4")
                lines.append(f"   {data['description']}")
                lines.append("")

            lines.append(
                "NB! Skoor on lihtsustatud hinnang. See ei arvesta kõiki "
                "mängumehaanikaid ega tähenda, et soovitatud ese oleks "
                "alati parim valik."
            )
            result = "\n".join(lines)

        self.update_text(self.advisor_output, result)

    def refresh_saved_list(self):
        """Uuendab salvestatud build'ide loendit."""
        self.saved_list.delete(0, tk.END)
        for build in self.builds:
            self.saved_list.insert(tk.END, build["name"])

    def save_current_build(self):
        """Küsib build'ile nime ja salvestab selle."""
        if not self.selected_items:
            messagebox.showinfo("Salvestamine", "Sinu build on tühi.")
            return

        name_window = tk.Toplevel(self.root)
        name_window.title("Salvesta build")
        name_window.geometry("300x120")
        name_window.transient(self.root)
        name_window.grab_set()

        ttk.Label(name_window, text="Sisesta build'i nimi:").pack(pady=(12, 4))
        name_var = tk.StringVar()
        entry = ttk.Entry(name_window, textvariable=name_var)
        entry.pack(fill="x", padx=12)
        entry.focus_set()

        def save():
            """Salvestab sisestatud nimega build'i."""
            name = name_var.get().strip()
            if not name:
                messagebox.showwarning("Puuduv nimi", "Sisesta build'ile nimi.")
                return

            self.builds.append({
                "name": name,
                "items": sorted(self.selected_items)
            })
            save_user_data(self.builds)
            self.refresh_saved_list()
            name_window.destroy()

        ttk.Button(name_window, text="Salvesta", command=save).pack(pady=10)

    def load_selected_build(self):
        """Laeb loendist valitud build'i."""
        selection = self.saved_list.curselection()
        if not selection:
            messagebox.showinfo("Laadimine", "Vali kõigepealt build.")
            return

        build = self.builds[selection[0]]
        self.selected_items = {
            item for item in build["items"] if item in ITEMS
        }
        self.refresh_build_list()
        self.notebook.select(self.build_tab)

    def delete_saved_build(self):
        """Kustutab valitud salvestatud build'i."""
        selection = self.saved_list.curselection()
        if not selection:
            messagebox.showinfo("Kustutamine", "Vali kõigepealt build.")
            return

        index = selection[0]
        name = self.builds[index]["name"]

        if messagebox.askyesno("Kustuta build", f"Kas kustutada „{name}”?"):
            del self.builds[index]
            save_user_data(self.builds)
            self.refresh_saved_list()


def main():
    """Käivitab programmi."""
    root = tk.Tk()
    app = IsaacHelperApp(root)
    app.refresh_saved_list()
    root.mainloop()


if __name__ == "__main__":
    main()
